@language ru;

[Преамбула]
{
    использовать Статистика;
    options.digits <- 3;
    options.figure_dpi <- 300;
}

[Подвал]
{
    функция формат_среднее(вещ m, вещ s) {
        вернуть $"{m:F1} ({s:F1})";
    }
}

## Описательная статистика когорты

Исследуется группа пациентов клинического наблюдения.

[Экспорт(пациенты, средний_возраст)]
{
    пациенты <- загрузить_csv("data/cohort.csv");
    средний_возраст <- среднее(пациенты.возраст);
    отклонение_возраста <- стд_отклонение(пациенты.возраст);
}

Средний возраст составил `{формат_среднее(средний_возраст, отклонение_возраста)}` лет.

[Вычисление(истина), ПодписьРис("Распределение возраста пациентов")]
{
    гистограмма(пациенты.возраст, делений: 20,
                заголовок: "Распределение возраста");
}

[Экспорт(таблица_сводки)]
{
    локальная группы <- пациенты$группа_лечения;
    таблица_сводки <- сводка(пациенты, по: группы,
                             показатели: [среднее, медиана, стд_отклонение]);
}

### Сводка по группам

[Эхо(ложь)]
{
    печать(таблица_сводки);
}
