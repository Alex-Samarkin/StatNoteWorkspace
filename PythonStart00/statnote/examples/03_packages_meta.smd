@language ru, en;

[Преамбула]
{
    @packages {
        "statnote.org/med/bundle" = "2026.11";
    }

    использовать Medical из package("statnote.org/med/bundle");
    использовать Статистика;
}

[Подвал]
{
    класс Когорта {
        открытый список пациенты;
        открытый строка название;

        функция Когорта(строка название) {
            это.название <- название;
            это.пациенты <- список();
        }

        открытый вещ средний_возраст() {
            вернуть среднее(пациенты.возраст);
        }
    }
}

## Нативное расширение через мультипакет

Мультипакет подключает выживаемость и фармакокинетику одной строкой.

[Экспорт(когорта)]
{
    когорта <- создать Когорта("Группа лечения");

    для i в 1:50 {
        локальная p <- создать Пациент($"P{i:03d}", случайное_целое(30, 80));
        p.вес <- случайное_нормальное(75, 10);
        p.рост <- случайное_нормальное(1.70, 0.10);

        p$категория <- если (p.имт > 30) "ожирение"
                       иначе если (p.имт > 25) "избыточный вес"
                       иначе "норма";

        когорта.пациенты.добавить(p);
    }
}

Средний возраст когорты `{когорта.название}`: `{когорта.средний_возраст():F1}` лет.

[Вычисление(истина), ПодписьРис("Оценка Каплана-Мейера из нативного пакета")]
{
    локальная время <- когорта.пациенты.время_наблюдения;
    локальная событие <- когорта.пациенты.исход;

    оценка <- км_оценка(время, событие, group: когорта.пациенты$категория);
    график(оценка);
}

### Происхождение функции

[Эхо(истина)]
{
    печать(origin(км_оценка));
    печать(inspect(когорта.пациенты[0]));
}
