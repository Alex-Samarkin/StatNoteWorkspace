@language ru;

[Преамбула]
{
    @configure {
        r { version: "4.4.0"; repos: ["https://cloud.r-project.org"]; }
    }

    использовать survival из r;
    использовать survminer из r;

    options.digits <- 3;
}

[Подвал]
{
    функция формат_p(вещ p) {
        вернуть p < 0.001 ? "p < 0.001" : $"p = {p:F3}";
    }
}

## Анализ выживаемости

Сравниваются две группы лечения методом Каплана-Мейера.

[Экспорт(пациенты)]
{
    пациенты <- загрузить_csv("data/survival.csv");
    пациенты.время <- пациенты.дата_исхода .- пациенты.дата_включения;
    пациенты.событие <- еслиelse(пациенты.статус == "умер", 1, 0);
}

[Вычисление(истина), ПодписьРис("Кривые выживаемости Каплана-Мейера")]
{
    локальная оценка <- survival::survfit(
        survival::Surv(время, событие) ~ группа_лечения,
        data: пациенты
    );

    локальная тест <- survival::survdiff(
        survival::Surv(время, событие) ~ группа_лечения,
        data: пациенты
    );

    p_значение <<- 1 - stats::pchisq(тест$chisq, df: 1);

    survminer::ggsurvplot(оценка, data: пациенты, pval: истина);
}

Медианная выживаемость различается между группами: `{формат_p(p_значение)}`.
